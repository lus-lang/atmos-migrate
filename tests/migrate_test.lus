local ROOT = string.match(TEST_DIR, "^(.*)[/\\][^/\\]*$")
pledge("load", "fs")
package.path = `$ROOT/?.lus;$(package.path)`

local migrate = require("migrate")

local counter = 0

-- Writes a directory of migration files and returns its path.
local function dir_with(files)
    counter = counter + 1
    local dir = `migrations_$counter`
    fs.createdirectory(dir, true)

    for name, text in pairs(files) do
        local f <close> = io.open(fs.path.join(dir, name), "w")
        f:write(text)
    end

    return dir
end

local function memory()
    return io.sqlite(":memory:")
end

local function names(db, sql)
    local out = {}

    for row in db:query(sql) do
        out[#out + 1] = row.name
    end

    return table.concat(out, ",")
end

local function tables(db)
    return names(
        db,
        "SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' ORDER BY name"
    )
end

local BASIC = {
    ["0001_create_users.sql"] = "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);",
    ["0001_create_users.down.sql"] = "DROP TABLE users;",
    ["0002_create_posts.sql"] = "CREATE TABLE posts (id INTEGER PRIMARY KEY);\nCREATE INDEX posts_id ON posts (id);",
    ["0002_create_posts.down.sql"] = "DROP TABLE posts;",
    ["0010_add_email.sql"] = "ALTER TABLE users ADD COLUMN email TEXT;",
    ["README.md"] = "notes",
}

local function load_orders_by_number_test()
    local dir = dir_with({
        ["10_c.sql"] = "SELECT 3;",
        ["2_b.sql"] = "SELECT 2;",
        ["0001_a.sql"] = "SELECT 1;",
        ["2_b.down.sql"] = "SELECT -2;",
        ["notes.txt"] = "skip",
    })
    local list = migrate.load(dir)
    assert(#list == 3)
    assert(list[1].name == "0001_a.sql" and list[1].version == 1)
    assert(list[2].name == "2_b.sql" and list[2].down == "SELECT -2;")
    assert(list[3].name == "10_c.sql" and list[3].down == nil)
    assert(#list[1].checksum == 64)
end

local function load_rejects_bad_sources_test()
    local ok, err = catch migrate.load(dir_with({ ["create.sql"] = "SELECT 1;" }))
    assert(not ok and migrate.iserror(err) and err.code == "source")
    ok, err = catch migrate.load(
        dir_with({ ["1_a.sql"] = "SELECT 1;", ["01_b.sql"] = "SELECT 1;" })
    )
    assert(not ok and err.code == "source" and tostring(err):find("share the number 1", 1, true))
    ok, err = catch migrate.load(dir_with({ ["1_a.down.sql"] = "SELECT 1;" }))
    assert(not ok and err.code == "source" and err.name == "1_a.down.sql")
    assert(not migrate.iserror("text"))
end

local function up_applies_in_order_test()
    local db <close> = memory()
    local dir = dir_with(BASIC)
    local applied = migrate.up(db, dir)
    assert(
        table.concat(applied, ",")
            == "0001_create_users.sql,0002_create_posts.sql,0010_add_email.sql"
    )
    assert(tables(db) == "posts,schema_migrations,users")
    db:run("INSERT INTO users (name, email) VALUES (?, ?)", "ada", "ada@example.com")
    assert(#migrate.up(db, dir) == 0)
end

local function up_records_checksum_and_time_test()
    local db <close> = memory()

    migrate.up(db, dir_with(BASIC), {
        clock = function()
            return 1782998100
        end,
    })

    local row = db:query("SELECT * FROM schema_migrations WHERE name = '0001_create_users.sql'")()
    local expected = string.transcode(
        crypto.hash("sha256", BASIC["0001_create_users.sql"]),
        "binary",
        "hex"
    )
    assert(row.checksum == expected)
    assert(row.applied_at == "2026-07-02T13:15:00Z")
end

local function up_to_target_test()
    local db <close> = memory()
    local dir = dir_with(BASIC)
    assert(#migrate.up(db, dir, { to = 1 }) == 1)
    assert(tables(db) == "schema_migrations,users")
    assert(#migrate.up(db, dir, { to = "0002_create_posts.sql" }) == 1)
    assert(#migrate.up(db, dir, { to = 2 }) == 0)
    assert(table.concat(migrate.up(db, dir), ",") == "0010_add_email.sql")

    assert(raises(function()
        migrate.up(db, dir, { to = "nope.sql" })
    end, "unknown migration 'nope.sql'"))
end

local function checksum_change_stops_test()
    local db <close> = memory()
    local files = table.clone(BASIC)
    migrate.up(db, dir_with(files), { to = 2 })
    files["0001_create_users.sql"] = "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER);"
    local ok, err = catch migrate.up(db, dir_with(files))
    assert(not ok and migrate.iserror(err))
    assert(err.code == "checksum" and err.name == "0001_create_users.sql")
    assert(tostring(err) == "migration 0001_create_users.sql changed after it was applied")
    -- The pending migration did not run.
    assert(
        names(db, "SELECT name FROM schema_migrations ORDER BY name")
            == "0001_create_users.sql,0002_create_posts.sql"
    )
end

local function failed_migration_rolls_back_test()
    local db <close> = memory()
    local source = {
        { name = "1_ok", up = "CREATE TABLE a (x);" },
        { name = "2_bad", up = "CREATE TABLE b (x); INSERT INTO missing VALUES (1);" },
        { name = "3_never", up = "CREATE TABLE c (x);" },
    }
    local ok, err = catch migrate.up(db, source)
    assert(not ok and err.code == "failed" and err.name == "2_bad")
    assert(tostring(err):find("migration 2_bad failed: ", 1, true))
    assert(tostring(err.cause):find("missing", 1, true))
    assert(tables(db) == "a,schema_migrations")
    assert(names(db, "SELECT name FROM schema_migrations") == "1_ok")
    source[2].up = "CREATE TABLE b (x);"
    assert(table.concat(migrate.up(db, source), ",") == "2_bad,3_never")
end

local function table_source_test()
    local db <close> = memory()
    local seen

    local source = {
        {
            name = "0002_seed",
            up = function(d)
                d:exec("INSERT INTO t VALUES (7)")
                seen = d
            end,
            down = function(d)
                d:exec("DELETE FROM t")
            end,
        },
        { name = "0001_create", up = "CREATE TABLE t (x);", down = "DROP TABLE t;" },
    }

    assert(table.concat(migrate.up(db, source), ",") == "0001_create,0002_seed")
    assert(seen == db)
    assert(db:query("SELECT x FROM t")().x == 7)
    assert(table.concat(migrate.down(db, source), ",") == "0002_seed")
    assert(db:query("SELECT count(*) AS n FROM t")().n == 0)

    assert(raises(function()
        migrate.up(db, { { name = "create", up = "SELECT 1" } })
    end, "does not start with a number"))

    assert(raises(function()
        migrate.up(db, { { name = "1_x" } })
    end, "has no up SQL"))

    assert(raises(function()
        migrate.up(db, 42)
    end, "directory or table of migrations expected"))
end

local function loaded_list_is_a_source_test()
    local db <close> = memory()
    local list = migrate.load(dir_with(BASIC))
    assert(#migrate.up(db, list) == 3)
    assert(#migrate.status(db, list) == 3)
end

local function down_default_and_steps_test()
    local db <close> = memory()
    local files = table.clone(BASIC)
    files["0010_add_email.down.sql"] = "ALTER TABLE users DROP COLUMN email;"
    local dir = dir_with(files)
    migrate.up(db, dir)
    assert(table.concat(migrate.down(db, dir), ",") == "0010_add_email.sql")
    assert(
        table.concat(migrate.down(db, dir, { steps = 2 }), ",")
            == "0002_create_posts.sql,0001_create_users.sql"
    )
    assert(tables(db) == "schema_migrations")
    assert(#migrate.down(db, dir) == 0)
    assert(#migrate.up(db, dir) == 3)
end

local function down_to_target_test()
    local db <close> = memory()
    local files = table.clone(BASIC)
    files["0010_add_email.down.sql"] = "ALTER TABLE users DROP COLUMN email;"
    local dir = dir_with(files)
    migrate.up(db, dir)
    assert(
        table.concat(migrate.down(db, dir, { to = "0001_create_users.sql" }), ",")
            == "0010_add_email.sql,0002_create_posts.sql"
    )
    assert(tables(db) == "schema_migrations,users")
    migrate.up(db, dir)
    assert(#migrate.down(db, dir, { to = 0 }) == 3)
    assert(tables(db) == "schema_migrations")
end

local function down_without_file_test()
    local db <close> = memory()
    local dir = dir_with(BASIC)
    migrate.up(db, dir)
    local ok, err = catch migrate.down(db, dir)
    assert(not ok and err.code == "irreversible" and err.name == "0010_add_email.sql")
    assert(
        names(db, "SELECT name FROM schema_migrations WHERE name LIKE '0010%'")
            == "0010_add_email.sql"
    )
end

local function failed_down_keeps_record_test()
    local db <close> = memory()
    local source = {
        { name = "1_a", up = "CREATE TABLE a (x);", down = "DROP TABLE a; DROP TABLE nope;" },
    }
    migrate.up(db, source)
    local ok, err = catch migrate.down(db, source)
    assert(not ok and err.code == "failed")
    assert(tables(db) == "a,schema_migrations")
    assert(names(db, "SELECT name FROM schema_migrations") == "1_a")
end

local function status_test()
    local db <close> = memory()
    local files = table.clone(BASIC)
    local dir = dir_with(files)
    local before = migrate.status(db, dir)
    assert(#before == 3 and not before[1].applied and before[1].applied_at == nil)
    assert(before[1].reversible and not before[3].reversible)

    migrate.up(db, dir, {
        to = 2,
        clock = function()
            return 0
        end,
    })

    files["0002_create_posts.sql"] = "CREATE TABLE posts (id);"
    local st = migrate.status(db, dir_with(files))
    assert(
        st[1].name == "0001_create_users.sql"
            and st[1].applied
            and st[1].applied_at == "1970-01-01T00:00:00Z"
    )
    assert(not st[1].changed and st[2].changed and st[2].applied)
    assert(not st[3].applied and st[3].version == 10)
end

local function missing_source_test()
    local db <close> = memory()
    local files = table.clone(BASIC)
    migrate.up(db, dir_with(files))
    files["0002_create_posts.sql"] = nil
    files["0002_create_posts.down.sql"] = nil
    local dir = dir_with(files)
    local st = migrate.status(db, dir)
    assert(#st == 3 and st[2].name == "0002_create_posts.sql" and st[2].missing and st[2].applied)
    local ok, err = catch migrate.up(db, dir)
    assert(not ok and err.code == "missing" and err.name == "0002_create_posts.sql")
end

local function out_of_order_test()
    local db <close> = memory()
    local source = {
        { name = "1_a", up = "CREATE TABLE a (x);" },
        { name = "3_c", up = "CREATE TABLE c (x);" },
    }
    migrate.up(db, source)
    source[#source + 1] = { name = "2_b", up = "CREATE TABLE b (x);" }
    local ok, err = catch migrate.up(db, source)
    assert(not ok and err.code == "order" and err.name == "2_b")
    assert(table.concat(migrate.up(db, source, { out_of_order = true }), ",") == "2_b")
    assert(tables(db) == "a,b,c,schema_migrations")
end

local function custom_table_test()
    local db <close> = memory()
    local source = { { name = "1_a", up = "CREATE TABLE a (x);", down = "DROP TABLE a;" } }
    migrate.up(db, source, { table = "app_migrations" })
    assert(tables(db) == "a,app_migrations")
    assert(migrate.status(db, source, { table = "app_migrations" })[1].applied)
    migrate.down(db, source, { table = "app_migrations" })
    assert(tables(db) == "app_migrations")

    assert(raises(function()
        migrate.up(db, source, { table = "x; DROP TABLE a" })
    end, "invalid migration table name"))
end

local function quoted_name_test()
    local db <close> = memory()
    local source = { { name = "1_it's", up = "CREATE TABLE a (x);", down = "DROP TABLE a;" } }
    migrate.up(db, source)
    assert(names(db, "SELECT name FROM schema_migrations") == "1_it's")
    migrate.down(db, source)
    assert(names(db, "SELECT name FROM schema_migrations") == "")
end

local function no_transaction_test()
    local in_transaction = 0
    local db <close> = memory()

    local adapter = {
        exec = function(_, sql)
            return db:exec(sql)
        end,
        query = function(_, sql)
            return db:query(sql)
        end,
        transaction = function(_, fn)
            in_transaction = in_transaction + 1
            return db:transaction(fn)
        end,
    }

    migrate.up(adapter, {
        { name = "1_a", up = "CREATE TABLE a (x);" },
        { name = "2_b", up = "-- migrate: no-transaction\nCREATE TABLE b (x);" },
    })
    assert(in_transaction == 1)
    assert(tables(db) == "a,b,schema_migrations")
end

-- An adapter in the shape that a network driver gives: `query` returns an array.
local function array_adapter_test()
    local db <close> = memory()
    local log = {}

    local adapter = {
        exec = function(_, sql)
            log[#log + 1] = sql
            return db:exec(sql)
        end,
        query = function(_, sql)
            local out = {}

            for row in db:query(sql) do
                out[#out + 1] = row
            end

            return out
        end,
        transaction = function(_, fn)
            db:exec("BEGIN")
            local ok, err = catch fn()
            db:exec(ok and "COMMIT" or "ROLLBACK")

            if not ok then
                error(err, 0)
            end
        end,
    }

    local source = {
        { name = "1_a", up = "CREATE TABLE a (x);", down = "DROP TABLE a;" },
        { name = "2_b", up = "INSERT INTO nope VALUES (1);" },
    }
    local ok, err = catch migrate.up(adapter, source)
    assert(not ok and err.code == "failed")
    assert(migrate.status(adapter, source)[1].applied)
    assert(table.concat(migrate.down(adapter, source), ",") == "1_a")
    assert(tables(db) == "schema_migrations")
end

local function file_database_test()
    local dir = dir_with(BASIC)

    do
        local db <close> = io.sqlite("app.db")
        assert(#migrate.up(db, dir) == 3)
    end

    local db <close> = io.sqlite("app.db")
    assert(#migrate.up(db, dir) == 0)
    assert(migrate.status(db, dir)[3].applied)
end
